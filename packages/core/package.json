{
  "name": "@open-cells/core",
  "version": "1.2.0",
  "description": "Open Cells Core",
  "type": "module",
  "types": "types/index.d.ts",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepublish": "npm run --unsafe-perm build",
    "typchk": "tsc -p ./tsconfig-typchk.json --noEmit",
    "unit-test": "npm run typchk && npm run test",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "files": [
    "src/**/*",
    "types/**/*"
  ],
  "keywords": [
    "core",
    "webcomponents"
  ],
  "dependencies": {
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-istanbul": "4.0.18",
    "camelcase": "^8.0.0",
    "playwright": "1.58.2",
    "sinon": "^21.0.1",
    "vite": "^7.3.1",
    "vitest": "4.0.18"
  },
  "directories": {
    "test": "test"
  },
  "publishConfig": {
    "access": "public"
  }
}
